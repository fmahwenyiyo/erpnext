# ERPNext local/production environment template.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env` (it is already listed in
# .gitignore). Everything below maps directly into either docker-compose.local.yml or Frappe's
# site/common_site_config.json via the `configurator` service — do not invent variable names
# Frappe/ERPNext does not actually consume.
#
# `docker-compose.local.yml` is a LOCAL development/test stack only. It is not a production
# topology on its own — see DEPLOYMENT.md for production hardening (secrets management, TLS,
# backup schedule, resource limits) on top of these same variables.

# --- PostgreSQL -------------------------------------------------------------
# Frappe connects using DB_HOST/DB_PORT/DB_NAME set via `bench set-config`; the configurator
# service in docker-compose.local.yml does this from POSTGRES_* below. POSTGRES_USER/PASSWORD
# also provision the actual PostgreSQL server (official `postgres` image env vars).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=erpnextlocal
POSTGRES_USER=postgres
# CHANGE ME. Also used as --db-root-password when `bench new-site --db-type postgres` runs.
POSTGRES_PASSWORD=change-me-strong-password
# Host-side port PostgreSQL is published on for local psql access. Local/dev only — do not expose
# this publicly in production; production PostgreSQL should not be reachable from outside the
# private network the app containers run in.
POSTGRES_HOST_PORT=55432

# --- Redis --------------------------------------------------------------
# No auth by default (matches frappe_docker's own local/dev topology) - both are internal-network
# only, not published to the host. Add `requirepass`/TLS for a production Redis, and set
# REDIS_CACHE/REDIS_QUEUE to match (frappe consumes them as redis://host:port URLs).
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# --- Frappe / ERPNext site -----------------------------------------------
SITE_NAME=frontend
# CHANGE ME. Administrator login password for the site created by `create-site`.
ADMIN_PASSWORD=change-me-strong-password
SOCKETIO_PORT=9000
# Gunicorn tuning (see docker/resources/start.sh) — raise for production traffic.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- Domain / reverse proxy / TLS ------------------------------------------
# Host header ERPNext expects to see; must match the domain the reverse proxy terminates TLS for
# in production. Local default is fine for `docker-compose.local.yml` (localhost:8080).
FRAPPE_SITE_NAME_HEADER=frontend
# Public host port for the frontend/nginx service.
HTTP_PUBLISH_PORT=8080
# Production only (see DEPLOYMENT.md) — domain + ACME email for a Let's Encrypt-issued cert.
DOMAIN=
LETSENCRYPT_EMAIL=

# --- Email (SMTP) -----------------------------------------------------------
# Never hard-code real SMTP credentials in code or compose files. Configure per-site via the
# Email Account doctype (recommended, supports multiple accounts / OAuth) or these variables if
# your provisioning script sets them at site-creation time. Leave blank for local/dev — outbound
# mail is simply not sent, which is safe for testing.
MAIL_SERVER=
MAIL_PORT=587
MAIL_LOGIN=
MAIL_PASSWORD=
MAIL_USE_TLS=1
AUTO_EMAIL_ID=test@example.com

# --- Backup / storage -------------------------------------------------------
# Local path (bind-mounted or a named volume) backups are written to by `bench backup`. See
# docs/BACKUP_RESTORE.md. For off-host backup storage in production, set these (frappe/restic-style
# remote target) rather than relying solely on the local disk.
BACKUP_PATH=./backups
# S3-compatible remote target for off-host backups (optional; leave blank to keep backups local
# only — NOT recommended for production, see docs/BACKUP_RESTORE.md).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Optional integrations (leave blank unless used) ------------------------
GOOGLE_MAPS_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
